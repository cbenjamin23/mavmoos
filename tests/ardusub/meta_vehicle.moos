ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community = ardusub_sitl
MOOSTimeWarp = 1
LatOrigin = $(LAT_ORIGIN)
LongOrigin = $(LONG_ORIGIN)

ProcessConfig = ANTLER
{
  MSBetweenLaunches = 80
  Run = $(DB_PATH) @ NewConsole = false
  Run = $(APP_PATH) @ NewConsole = false ~ iMAVLink
  Run = $(HELM_PATH) @ NewConsole = false
}

ProcessConfig = iMAVLink
{
  AppTick = 40
  CommsTick = 40
  bind_address = 127.0.0.1
  bind_port = $(BIND_PORT)
  peer_address = 127.0.0.1
  peer_port = $(PEER_PORT)
  target_system = 1
  target_component = 1
  expected_type = 12
  expected_autopilot = 3
  simulation_only = true
  sitl_pid = $(SITL_PID)
  shadow_mode = false
  helm_enabled = true
  control_helm = true
  control_native_actions = false
  vehicle_profile = ardusub
  plugins = telemetry,ardusub_control
  plugin_directory = $(PLUGIN_DIRECTORY)
  helm_source = pHelmIvP
  freshness_timeout = 0.75
  handoff_window = 0.7
  field_spread = 0.25
  nav_position_timeout = 0.5
  firmware_requests = false
  max_datagrams_per_iter = 96
  max_queue_age = 0.25
  lat_origin = $(LAT_ORIGIN)
  long_origin = $(LONG_ORIGIN)
}

ProcessConfig = pHelmIvP
{
  AppTick = 10
  CommsTick = 20
  behaviors = targ_sub.bhv
  domain = course:0:359:360
  domain = speed:0:1:21
  domain = depth:0:8:81
  start_in_drive = true
  verbose = quiet
}

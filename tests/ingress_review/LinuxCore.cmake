cmake_minimum_required(VERSION 3.24)
project(MAVMOOSIndependentCore LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
find_package(Threads REQUIRED)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
enable_testing()
add_library(mavlink_headers INTERFACE)
target_include_directories(mavlink_headers SYSTEM INTERFACE "${MAVLINK_ROOT}")
add_subdirectory("${REPO_ROOT}/src/libmavmoos_rx" "${CMAKE_BINARY_DIR}/rx")
add_subdirectory("${REPO_ROOT}/src/libmavmoos_egress" "${CMAKE_BINARY_DIR}/egress")
add_subdirectory("${REPO_ROOT}/src/libmavmoos_runtime" "${CMAKE_BINARY_DIR}/runtime")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/plugins")

add_library(mavmoos_control_components STATIC
  "${REPO_ROOT}/src/libmavmoos_control/CopterCommands.cpp"
  "${REPO_ROOT}/src/libmavmoos_control/CopterOperations.cpp"
  "${REPO_ROOT}/src/libmavmoos_control/HelmAdapter.cpp"
  "${REPO_ROOT}/src/libmavmoos_control/ArduCopterBackend.cpp")
set_target_properties(mavmoos_control_components PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(mavmoos_control_components PUBLIC
  "${REPO_ROOT}/src/libmavmoos_control" "${REPO_ROOT}/src/libmavmoos_runtime")
target_link_libraries(mavmoos_control_components PUBLIC mavlink_headers mavmoos_egress)
add_library(mavmoos_arducopter_control MODULE "${REPO_ROOT}/src/plugins/ArduCopterControlPlugin.cpp")
target_link_libraries(mavmoos_arducopter_control PRIVATE mavmoos_control_components)
set_target_properties(mavmoos_arducopter_control PROPERTIES PREFIX "")
add_library(mavmoos_parameters MODULE "${REPO_ROOT}/src/plugins/ParameterPlugin.cpp")
target_include_directories(mavmoos_parameters PRIVATE "${REPO_ROOT}/src/libmavmoos_runtime")
target_link_libraries(mavmoos_parameters PRIVATE mavlink_headers)
set_target_properties(mavmoos_parameters PROPERTIES PREFIX "")
add_library(mavmoos_missions MODULE "${REPO_ROOT}/src/plugins/MissionPlugin.cpp")
target_include_directories(mavmoos_missions PRIVATE "${REPO_ROOT}/src/libmavmoos_runtime")
target_link_libraries(mavmoos_missions PRIVATE mavlink_headers)
set_target_properties(mavmoos_missions PROPERTIES PREFIX "")
add_subdirectory("${REPO_ROOT}/src/libmavmoos_rover" "${CMAKE_BINARY_DIR}/rover")
target_include_directories(mavmoos_rover_components PRIVATE "${REPO_ROOT}/src/libmavmoos_runtime")
add_library(mavmoos_ardurover_control MODULE "${REPO_ROOT}/src/plugins/ArduRoverControlPlugin.cpp")
target_link_libraries(mavmoos_ardurover_control PRIVATE mavmoos_rover_components mavmoos_control_components)
set_target_properties(mavmoos_ardurover_control PROPERTIES PREFIX "")
add_executable(mission_runtime_tests "${REPO_ROOT}/tests/MissionRuntimeTests.cpp")
target_link_libraries(mission_runtime_tests PRIVATE mavmoos_runtime)
add_test(NAME mission_runtime COMMAND mission_runtime_tests $<TARGET_FILE:mavmoos_arducopter_control>)
add_executable(mission_provider_tests "${REPO_ROOT}/tests/missions/MissionPluginTests.cpp" "${REPO_ROOT}/src/plugins/MissionPlugin.cpp")
target_include_directories(mission_provider_tests PRIVATE "${REPO_ROOT}/src/libmavmoos_runtime")
target_link_libraries(mission_provider_tests PRIVATE mavlink_headers ${CMAKE_DL_LIBS})
add_test(NAME mission_provider COMMAND mission_provider_tests $<TARGET_FILE:mavmoos_missions>)
add_executable(copter_operation_tests "${REPO_ROOT}/tests/operations/CopterOperationTests.cpp")
target_link_libraries(copter_operation_tests PRIVATE mavmoos_control_components ${CMAKE_DL_LIBS})
add_test(NAME copter_operations COMMAND copter_operation_tests $<TARGET_FILE:mavmoos_arducopter_control>)
add_executable(rover_backend_tests "${REPO_ROOT}/tests/rover/RoverBackendTests.cpp")
target_link_libraries(rover_backend_tests PRIVATE mavmoos_rover_components)
add_test(NAME rover_backend COMMAND rover_backend_tests)
add_executable(rover_control_tests "${REPO_ROOT}/tests/rover/RoverControlTests.cpp")
target_link_libraries(rover_control_tests PRIVATE mavmoos_runtime mavmoos_rover_components ${CMAKE_DL_LIBS})
add_test(NAME rover_control COMMAND rover_control_tests $<TARGET_FILE:mavmoos_ardurover_control>)
add_test(NAME mission_request_helper COMMAND "${Python3_EXECUTABLE}" "${REPO_ROOT}/tests/missions/MissionRequestTests.py")
add_test(NAME mission_evidence_helper COMMAND "${Python3_EXECUTABLE}" "${REPO_ROOT}/tests/missions/MissionEvidenceTests.py")
foreach(component command helm)
  if(component STREQUAL "command")
    set(test_source CommandPluginTests.cpp)
  else()
    set(test_source HelmPluginTests.cpp)
  endif()
  add_executable(${component}_component_tests "${REPO_ROOT}/tests/${test_source}")
  target_link_libraries(${component}_component_tests PRIVATE mavmoos_control_components)
  add_test(NAME ${component}_component COMMAND ${component}_component_tests)
endforeach()
add_executable(parameter_tests "${REPO_ROOT}/tests/ParameterPluginTests.cpp" "${REPO_ROOT}/src/plugins/ParameterPlugin.cpp")
target_include_directories(parameter_tests PRIVATE "${REPO_ROOT}/src/libmavmoos_runtime")
target_link_libraries(parameter_tests PRIVATE mavlink_headers)
add_test(NAME parameters COMMAND parameter_tests)
add_executable(control_backend_tests "${REPO_ROOT}/tests/control/ControlBackendTests.cpp")
target_link_libraries(control_backend_tests PRIVATE mavmoos_control_components)
add_test(NAME control_backend COMMAND control_backend_tests)
add_executable(control_plugin_tests "${REPO_ROOT}/tests/control/ControlPluginTests.cpp")
target_link_libraries(control_plugin_tests PRIVATE mavmoos_runtime ${CMAKE_DL_LIBS})
add_test(NAME control_plugin COMMAND control_plugin_tests $<TARGET_FILE:mavmoos_arducopter_control>)

foreach(fixture provider observer)
  add_library(${fixture}_lifetime_fixture MODULE "${REPO_ROOT}/tests/control/ProviderLifetimeFixtures.cpp")
  target_include_directories(${fixture}_lifetime_fixture PRIVATE
    "${REPO_ROOT}/src/libmavmoos_runtime" "${REPO_ROOT}/src/libmavmoos_control")
  target_link_libraries(${fixture}_lifetime_fixture PRIVATE mavlink_headers)
endforeach()
target_compile_definitions(provider_lifetime_fixture PRIVATE MAVMOOS_REPLACEABLE_PROVIDER)
target_link_libraries(provider_lifetime_fixture PRIVATE mavmoos_control_components)
add_executable(provider_lifetime_tests "${REPO_ROOT}/tests/control/ProviderLifetimeTests.cpp")
target_link_libraries(provider_lifetime_tests PRIVATE mavmoos_runtime)
add_test(NAME provider_lifetime COMMAND provider_lifetime_tests $<TARGET_FILE:provider_lifetime_fixture> $<TARGET_FILE:observer_lifetime_fixture>)

add_executable(module_selection_tests "${REPO_ROOT}/tests/ModuleSelectionTests.cpp")
target_link_libraries(module_selection_tests PRIVATE mavmoos_runtime)
add_test(NAME module_selection COMMAND module_selection_tests)

foreach(fixture valid missing null collision resource request invalid companion)
  add_library(plugin_fixture_${fixture} MODULE "${REPO_ROOT}/tests/PluginHostTests.cpp")
  target_compile_definitions(plugin_fixture_${fixture} PRIVATE MAVMOOS_TEST_PLUGIN_FIXTURE)
  target_include_directories(plugin_fixture_${fixture} PRIVATE "${REPO_ROOT}/src/libmavmoos_runtime")
  target_link_libraries(plugin_fixture_${fixture} PRIVATE mavlink_headers)
endforeach()
target_compile_definitions(plugin_fixture_missing PRIVATE MAVMOOS_TEST_MISSING_FACTORY)
target_compile_definitions(plugin_fixture_null PRIVATE MAVMOOS_TEST_NULL_FACTORY)
target_compile_definitions(plugin_fixture_collision PRIVATE MAVMOOS_TEST_CAP_COLLISION)
target_compile_definitions(plugin_fixture_resource PRIVATE MAVMOOS_TEST_RESOURCE_COLLISION)
target_compile_definitions(plugin_fixture_request PRIVATE MAVMOOS_TEST_REQUEST_COLLISION)
target_compile_definitions(plugin_fixture_invalid PRIVATE MAVMOOS_TEST_INVALID_DESCRIPTOR)
target_compile_definitions(plugin_fixture_companion PRIVATE MAVMOOS_TEST_COMPANION)
add_executable(plugin_host_tests "${REPO_ROOT}/tests/PluginHostTests.cpp")
target_link_libraries(plugin_host_tests PRIVATE mavmoos_runtime ${CMAKE_DL_LIBS})
add_test(NAME plugin_host COMMAND plugin_host_tests $<TARGET_FILE:plugin_fixture_valid> $<TARGET_FILE:plugin_fixture_missing> $<TARGET_FILE:plugin_fixture_null> $<TARGET_FILE:plugin_fixture_collision> $<TARGET_FILE:plugin_fixture_resource> $<TARGET_FILE:plugin_fixture_request> $<TARGET_FILE:plugin_fixture_invalid> $<TARGET_FILE:plugin_fixture_companion>)
add_executable(runtime_tests "${REPO_ROOT}/tests/RuntimeTests.cpp")
target_link_libraries(runtime_tests PRIVATE mavmoos_runtime)
add_test(NAME runtime COMMAND runtime_tests $<TARGET_FILE:mavmoos_arducopter_control>)
add_executable(ingress_runtime_tests "${REPO_ROOT}/tests/IngressRuntimeTests.cpp")
target_link_libraries(ingress_runtime_tests PRIVATE mavmoos_runtime)
add_test(NAME ingress_runtime COMMAND ingress_runtime_tests $<TARGET_FILE:mavmoos_parameters> $<TARGET_FILE:mavmoos_arducopter_control>)
add_executable(rx_tests "${REPO_ROOT}/tests/RxTests.cpp")
target_link_libraries(rx_tests PRIVATE mavmoos_rx)
add_test(NAME rx_core COMMAND rx_tests)
add_executable(ingress_tests "${REPO_ROOT}/tests/ingress/IngressTests.cpp")
target_include_directories(ingress_tests PRIVATE "${REPO_ROOT}/tests")
target_link_libraries(ingress_tests PRIVATE mavmoos_rx Threads::Threads)
foreach(scenario policy loopback matrix)
  add_test(NAME ingress_${scenario} COMMAND ingress_tests ${scenario})
endforeach()
add_executable(egress_fake_tests "${REPO_ROOT}/tests/EgressFakeTests.cpp")
target_link_libraries(egress_fake_tests PRIVATE mavmoos_egress)
add_test(NAME egress_fake COMMAND egress_fake_tests "${CMAKE_BINARY_DIR}/p2-fake.jsonl")
add_executable(egress_loopback_tests "${REPO_ROOT}/tests/EgressLoopbackTests.cpp")
target_link_libraries(egress_loopback_tests PRIVATE mavmoos_egress)
add_test(NAME egress_loopback COMMAND egress_loopback_tests "${CMAKE_BINARY_DIR}/p2-loopback.jsonl")
add_test(NAME owned_cleanup COMMAND "${Python3_EXECUTABLE}" "${REPO_ROOT}/tests/OwnedProcessesTests.py")
set_tests_properties(command_component helm_component parameters control_backend control_plugin provider_lifetime module_selection plugin_host runtime ingress_runtime rx_core ingress_policy ingress_loopback ingress_matrix egress_fake egress_loopback owned_cleanup PROPERTIES TIMEOUT 30 RUN_SERIAL TRUE)

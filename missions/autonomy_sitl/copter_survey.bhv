//-------------------------------------------------
initialize DEPLOY = false
initialize MOOS_MANUAL_OVERRIDE = false
initialize SURVEY_DONE = false
initialize SITL_ROUTE_FINISHED = false
initialize BHV_ERROR_SEEN = false

//----------------------------------------------------
Behavior = BHV_Waypoint
{
  name = survey_track
  pwt = 100
  condition = DEPLOY = true
  condition = SURVEY_DONE = false
  updates = SURVEY_UPDATE
  wpt_index_var = SURVEY_INDEX
  points = 0,7:0,15:0,21:0,26:0,30
  endflag = SURVEY_DONE = true
  speed = 1.5
  capture_radius = 1.5
  slip_radius = 3
  lead = 2
  lead_to_start = true
  repeat = 0
}

//----------------------------------------------------
Behavior = BHV_Waypoint
{
  name = homeward_leg
  pwt = 100
  condition = DEPLOY = true
  condition = SURVEY_DONE = true
  condition = SITL_ROUTE_FINISHED = false
  activeflag = SURVEY_RETURNING = true
  points = 0,0
  endflag = SITL_ROUTE_FINISHED = true
  speed = 1.5
  capture_radius = 1.5
  slip_radius = 3
  repeat = 0
}

//----------------------------------------------------
Behavior = BHV_StationKeep
{
  name = home_station
  pwt = 1
  condition = DEPLOY = true
  station_pt = 0,0
  center_activate = false
  inner_radius = 0.8
  outer_radius = 2.5
  outer_speed = 1
  transit_speed = 1
}

//----------------------------------------------------
Behavior = BHV_ConstantAltitude
{
  name = flight_height
  pwt = 100
  condition = DEPLOY = true
  altitude = 5
  duration = -1
}

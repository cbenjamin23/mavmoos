//-------------------------------------------------
// FILE: meta_vehicle.moos
// NAME: Charles Benjamin
//-------------------------------------------------
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community = $(COMMUNITY)
MOOSTimeWarp = 1
LatOrigin = 42.358456
LongOrigin = -71.087589

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100
  Run = MOOSDB @ NewConsole = false
  $(BRIDGE_LAUNCH)
  Run = $(HELM_PATH) @ NewConsole = false ~ pHelmIvP
  Run = pLogger @ NewConsole = false
  Run = pMissionEval @ NewConsole = false
}

//----------------------------------------------------
ProcessConfig = iMAVLink
{
  AppTick = 30
  CommsTick = 30
  bind_address = 127.0.0.1
  bind_port = $(BIND_PORT)
  peer_address = 127.0.0.1
  peer_port = $(PEER_PORT)
  target_system = 1
  target_component = 1
  expected_type = $(EXPECTED_TYPE)
  expected_autopilot = 3
  vehicle_profile = $(PROFILE)
  plugins = $(PLUGINS)
  control_replay_directory = $(REPLAY_DIRECTORY)
  $(MANAGED_AUTO_CONFIG)
  $(AUTO_RECOVERY_CONFIG)
  simulation_only = true
  shadow_mode = false
  helm_enabled = true
  control_native_actions = true
  sitl_pid = $(SITL_PID)
  plugin_directory = $(PLUGIN_DIRECTORY)
  lat_origin = 42.358456
  long_origin = -71.087589
  helm_source = pHelmIvP
  freshness_timeout = 2
  handoff_window = 0.5
  field_spread = 0.5
  nav_position_timeout = 0.5
}

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick = 10
  CommsTick = 20
  behaviors = targ_vehicle.bhv
  domain = course:0:359:360
  domain = $(SPEED_DOMAIN)
  $(ALTITUDE_CONFIG)
  start_in_drive = true
  verbose = quiet
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick = 10
  CommsTick = 20
  File = LOG_AUTONOMY
  PATH = ./logs
  SyncLog = false
  AsyncLog = true
  LogAuxSrc = true
  WildCardLogging = true
}

//----------------------------------------------------
ProcessConfig = pMissionEval
{
  AppTick = 8
  CommsTick = 20
  mailflag = @BHV_ERROR#BHV_ERROR_SEEN=true
  lead_condition = SITL_INDEPENDENT_DONE = true
  pass_condition = SITL_ROUTE_FINISHED = true
  pass_condition = $(REQUIRED_FLAG) = true
  pass_condition = BHV_ERROR_SEEN = false
  result_flag = MISSION_EVALUATED = true
  report_file = results.txt
  report_column = grade=$[GRADE]
}

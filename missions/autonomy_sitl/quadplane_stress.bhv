//-------------------------------------------------
// FILE: quadplane_stress.bhv
// NAME: MAVMOOS project
//-------------------------------------------------
initialize DEPLOY = false
initialize MOOS_MANUAL_OVERRIDE = false
initialize AUTONOMY_STAGE = entry
initialize BHV_ERROR_SEEN = false

Behavior = BHV_Waypoint
{
  name = inspection_entry
  pwt = 100
  condition = DEPLOY = true
  condition = AUTONOMY_STAGE = entry
  points = 8,0
  speed = 2
  capture_radius = 1.5
  slip_radius = 2.5
  endflag = AUTONOMY_STAGE = climb
}

Behavior = BHV_Waypoint
{
  name = revised_inspection_track
  pwt = 100
  condition = DEPLOY = true
  condition = AUTONOMY_STAGE = climb
  updates = AUTONOMY_ROUTE
  points = 1500,1500
  speed = 2
  capture_radius = 1.5
  slip_radius = 2.5
  endflag = AUTONOMY_STAGE = done
}

Behavior = BHV_ConstantAltitude
{
  name = entry_height
  pwt = 100
  condition = DEPLOY = true
  condition = AUTONOMY_STAGE = entry
  altitude = 60
  duration = -1
}

Behavior = BHV_ConstantAltitude
{
  name = inspection_height
  pwt = 100
  condition = DEPLOY = true
  condition = AUTONOMY_STAGE != entry
  altitude = 65
  duration = -1
}

Behavior = BHV_StationKeep
{
  name = wait_for_return
  pwt = 100
  condition = DEPLOY = true
  condition = AUTONOMY_STAGE = done
  center_activate = true
  inner_radius = 0.8
  outer_radius = 2.5
  outer_speed = 1
  transit_speed = 1
}

Behavior = BHV_ConstantHeading
{
  name = interim_course
  pwt = 1
  condition = DEPLOY = true
  heading = 90
  duration = -1
}

Behavior = BHV_ConstantSpeed
{
  name = interim_speed
  pwt = 1
  condition = DEPLOY = true
  speed = 0
  duration = -1
}

//-------------------------------------------------
// FILE: meta_vehicle.moos
// NAME: Charles Benjamin
//-------------------------------------------------
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community = plane_sitl
MOOSTimeWarp = 1
LatOrigin = $(LAT_ORIGIN)
LongOrigin = $(LONG_ORIGIN)

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100
  Run = $(MOOSDB_PATH) @ NewConsole = false ~ MOOSDB
  Run = $(HELM_PATH) @ NewConsole = false ~ pHelmIvP
  Run = $(LOGGER_PATH) @ NewConsole = false ~ pLogger
}

//----------------------------------------------------
// The fixture owns iMAVLink separately so its process can be restarted while
// the same stock pAntler community, simulator and helm stay running.
ProcessConfig = iMAVLink
{
  AppTick = 30
  CommsTick = 30
  bind_address = 127.0.0.1
  bind_port = $(BIND_PORT)
  peer_address = 127.0.0.1
  peer_port = $(PEER_PORT)
  target_system = 1
  target_component = 1
  expected_type = 1
  expected_autopilot = 3
  vehicle_profile = arduplane
  plugins = telemetry,air_data,arduplane_control
  simulation_only = $(SIMULATION_ONLY)
  shadow_mode = $(SHADOW_MODE)
  helm_enabled = true
  sitl_pid = $(SITL_PID)
  plugin_directory = $(PLUGIN_DIRECTORY)
  lat_origin = $(LAT_ORIGIN)
  long_origin = $(LONG_ORIGIN)
  helm_source = pHelmIvP
  freshness_timeout = 1.5
  handoff_window = 1.0
  field_spread = 0.35
  nav_position_timeout = 0.5
}

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick = 10
  CommsTick = 20
  behaviors = targ_plane.bhv
  domain = course:0:359:360
  domain = speed:0:30:31
  domain = altitude:0:160:161
  start_in_drive = true
  verbose = quiet
  ivp_behavior_dir = $(BEHAVIOR_DIRECTORY)
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick = 10
  CommsTick = 20
  File = LOG_PLANE
  PATH = ./moos_logs
  SyncLog = false
  AsyncLog = true
  LogAuxSrc = true
  WildCardLogging = true
}

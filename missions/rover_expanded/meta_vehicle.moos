//-------------------------------------------------
// FILE: meta_vehicle.moos
// NAME: Charles Benjamin
//-------------------------------------------------
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community = rover_expanded
MOOSTimeWarp = 1
LatOrigin = $(LAT_ORIGIN)
LongOrigin = $(LONG_ORIGIN)

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100
  Run = MOOSDB @ NewConsole = false
  Run = $(APP_PATH) @ NewConsole = false ~ iMAVLink
  Run = $(HELM_PATH) @ NewConsole = false ~ pHelmIvP
  Run = pLogger @ NewConsole = false
  Run = uProcessWatch @ NewConsole = false
}

//----------------------------------------------------
ProcessConfig = iMAVLink
{
  AppTick = 30
  CommsTick = 30
  bind_address = 127.0.0.1
  bind_port = $(BIND_PORT)
  peer_address = 127.0.0.1
  peer_port = $(PEER_PORT)
  target_system = 1
  target_component = 1
  expected_type = $(EXPECTED_TYPE)
  expected_autopilot = 3
  vehicle_profile = $(PROFILE)
  plugins = telemetry,parameters,ardurover_control
  $(NATIVE_REPLAY_CONFIG)
  simulation_only = $(SIMULATION_ONLY)
  shadow_mode = $(SHADOW_MODE)
  helm_enabled = $(HELM_ENABLED)
  control_native_actions = $(NATIVE_ENABLED)
  sitl_pid = $(SITL_PID)
  plugin_directory = $(PLUGIN_DIRECTORY)
  lat_origin = $(LAT_ORIGIN)
  long_origin = $(LONG_ORIGIN)
  helm_source = pHelmIvP
  freshness_timeout = 2
  handoff_window = 0.5
  field_spread = 0.5
  nav_position_timeout = 0.5
  heartbeat_timeout = 2
}

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick = 10
  CommsTick = 20
  behaviors = targ_rover.bhv
  domain = course:0:359:360
  domain = speed:0:2:21
  start_in_drive = true
  verbose = quiet
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick = 10
  CommsTick = 20
  File = LOG_ROVER_EXPANDED
  PATH = ./logs
  SyncLog = false
  AsyncLog = true
  LogAuxSrc = true
  WildCardLogging = true
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick = 2
  CommsTick = 2
  watch = iMAVLink
  watch = pHelmIvP
  watch = pLogger
  nowatch = uMAC*
}
